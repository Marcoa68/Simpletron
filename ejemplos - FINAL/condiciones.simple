10 rem prueba las seis condiciones: imprime 1 si se cumple y 0 si no
20 input a
30 input b
40 if a == b goto 70
50 print 0
60 goto 80
70 print 1
80 if a != b goto 110
90 print 0
100 goto 120
110 print 1
120 if a < b goto 150
130 print 0
140 goto 160
150 print 1
160 if a > b goto 190
170 print 0
